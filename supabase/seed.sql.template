-- ========================================
-- ログ枠の追加付与（026）
-- handle_new_user の初期枠 10 に加え、テストユーザーへ 20 枠を先に付与する。
-- 以降の dives insert は consume_log_credit トリガーで 1 件 1 枠を消費するため、
-- 付与より前に dives を投入すると seed が残枠不足で失敗しうる。順序を変えないこと
-- ========================================
select public.apply_credit_ledger_entry('${TEST_USER_ID}', 'initial_grant', 20);

-- ========================================
-- デイリーボーナスの当日分事前付与（036）
-- 認証済みレイアウトは当日（JST）初アクセスで grant_daily_bonus を呼び、
-- 付与が発生した訪問では獲得モーダルを表示する。E2E 用の既存ユーザーに
-- 当日分を事前付与しておくことで、既存 E2E テストの初回ログインにモーダルが
-- 被さって操作を妨害するのを防ぐ（specs/036 research.md R4）。
-- モーダル表示の検証は bonus@example.com（事前付与なし）で行う。
-- 注意: seed 実行日と E2E 実行日が JST でまたがると効果を失うため、
-- E2E は make supabase-reset 直後に実行すること。
-- ========================================
select public.apply_credit_ledger_entry('${TEST_USER_ID}', 'daily_bonus', 1, (now() at time zone 'Asia/Tokyo')::date);
select public.apply_credit_ledger_entry('000000ad-0000-0000-0000-000000000001', 'daily_bonus', 1, (now() at time zone 'Asia/Tokyo')::date);
select public.apply_credit_ledger_entry('000000bd-0000-0000-0000-000000000002', 'daily_bonus', 1, (now() at time zone 'Asia/Tokyo')::date);
select public.apply_credit_ledger_entry('000000ce-0000-0000-0000-000000000003', 'daily_bonus', 1, (now() at time zone 'Asia/Tokyo')::date);

