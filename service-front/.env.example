NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth（016-google-login）。Google Cloud Console の OAuth 2.0 クライアントから取得
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# RESEND_API_KEY は問い合わせメールに加え、Supabase Auth の SMTP 送信元にも使う（023）。
# config.toml [auth.email.smtp] が pass=env(RESEND_API_KEY) / admin_email=env(CONTACT_MAIL_FROM) を参照する。
RESEND_API_KEY=
CONTACT_MAIL_FROM=
CONTACT_NOTIFY_TO=

# SMS 2 要素認証（023 / US2）。Twilio 認証情報。config.toml [auth.sms.twilio] が参照する
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
# --- Stripe（026-log-monetization）---
# ログパック購入の決済に使用。テストモードのキーは Stripe ダッシュボード > Developers > API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# webhook 署名検証用。ローカルは `stripe listen --forward-to localhost:3000/api/stripe/webhook` が発行する whsec_...
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Supabase service_role キー（Stripe webhook の枠付与用・026）
# ローカルは supabase status の SERVICE_ROLE_KEY（公開デモキー）を設定。本番キーは絶対にコミットしない
SUPABASE_SERVICE_ROLE_KEY=
