{
    "name": "service-front",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "dev:https": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
        "build": "next build",
        "start": "next start",
        "lint": "biome lint .",
        "lint:fix": "biome lint . --write",
        "lint:markup": "markuplint \"./src/**/*.{jsx,tsx}\"",
        "format": "biome format . --write",
        "format:check": "biome format .",
        "check": "biome check .",
        "check:fix": "biome check . --write --unsafe",
        "type-check": "tsc --noEmit",
        "test": "vitest run --project=unit",
        "test:watch": "vitest --project=unit",
        "test:coverage": "vitest run --project=unit --coverage",
        "test:storybook": "vitest run --project=storybook",
        "test:storybook:ui": "vitest --project=storybook --ui",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:a11y": "playwright test tests/a11y",
        "test:all": "npm run test && npm run test:storybook && npm run test:e2e",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "ci:storybook": "storybook build && npm run test:storybook",
        "validate": "npm run type-check && npm run check && npm run lint:markup && npm run test"
    },
    "dependencies": {
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.0.9",
        "@react-pdf/renderer": "^4.5.1",
        "@repo/core": "*",
        "@repo/supabase": "*",
        "@repo/ui": "*",
        "@tanstack/react-query": "^5.62.0",
        "clsx": "^2.1.1",
        "lucide-react": "^1.16.0",
        "next": "^16.3.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.54.2",
        "resend": "^6.16.0",
        "sharp": "^0.35.4",
        "stripe": "^22.3.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "yup": "^1.6.1",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@biomejs/biome": "2.4.16",
        "@chromatic-com/storybook": "^5.2.1",
        "@hookform/resolvers": "^4.1.3",
        "@markuplint/jsx-parser": "^4.18.3",
        "@markuplint/react-spec": "^4.18.0",
        "@playwright/test": "^1.60.0",
        "@storybook/addon-a11y": "^10.4.0",
        "@storybook/addon-docs": "^10.4.0",
        "@storybook/addon-mcp": "^0.6.0",
        "@storybook/addon-vitest": "^10.4.0",
        "@storybook/nextjs-vite": "^10.4.0",
        "@tailwindcss/postcss": "^4",
        "@tailwindcss/vite": "^4",
        "@tanstack/react-query-devtools": "^5.62.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@types/node": "^24.13.2",
        "@types/react": "19.0.2",
        "@types/react-dom": "19.0.2",
        "@vercel/speed-insights": "^1.2.0",
        "@vitest/browser-playwright": "^4.1.7",
        "@vitest/coverage-v8": "^4.1.7",
        "jsdom": "^28.1.0",
        "markuplint": "^4.18.3",
        "msw": "^2.7.0",
        "msw-storybook-addon": "^2.0.4",
        "playwright": "^1.60.0",
        "shadcn": "^4.7.0",
        "storybook": "^10.4.0",
        "tailwindcss": "^4",
        "ts-node": "10.9.2",
        "typescript": "5.7.2",
        "vite": "^8.0.14",
        "vitest": "^4.1.7"
    },
    "volta": {
        "node": "24.18.0"
    },
    "engines": {
        "node": ">=24.0.0 <25.0.0",
        "npm": ">=11.0.0"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
