# Temporary files
tmp/

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.tsbuildinfo
.next/
out/

# Environment variables
.env
.env.local
.env.*.local

# Supabase: seed.sql は seed.sql.template を envsubst で展開した生成物
supabase/seed.sql

# Logs
logs/
*.log

# summary logs
summary/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/

# Steering files (task management - temporary)
.steering/*
!.steering/.gitkeep

# spec-kit: 作業中フィーチャーのポインタ（個人の作業状態）
.specify/feature.json

# Lock files (keep package-lock.json for consistency)
# yarn.lock

# サブディレクトリで起動したセッションが生成するものも含めて ignore する
**/.claude/settings.local.json

# Playwright
screenshots/*
!screenshots/.gitkeep

# MarkUp
design/*
!design/.gitkeep

# Examples (検証用プロジェクト)
examples/*/node_modules/
examples/*/.next/
examples/*/dist/
examples/*/out/
examples/*/.turbo/
examples/*/package-lock.json
examples/*/yarn.lock
examples/*/pnpm-lock.yaml.claude/worktrees/
.claude/worktrees/
