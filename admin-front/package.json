{
    "name": "admin-front",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev -p 3001",
        "dev:https": "next dev -p 3001 --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
        "build": "next build",
        "start": "next start -p 3001",
        "lint": "biome lint .",
        "lint:fix": "biome lint . --write",
        "format": "biome format . --write",
        "format:check": "biome format .",
        "check": "biome check .",
        "check:fix": "biome check . --write --unsafe",
        "type-check": "tsc --noEmit",
        "test": "vitest run --project=unit",
        "test:watch": "vitest --project=unit",
        "test:coverage": "vitest run --project=unit --coverage",
        "validate": "npm run type-check && npm run check && npm run test"
    },
    "dependencies": {
        "@hookform/resolvers": "^4.1.3",
        "@repo/supabase": "*",
        "@repo/ui": "*",
        "clsx": "^2.1.1",
        "lucide-react": "^1.16.0",
        "next": "^16.3.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.54.2",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "yup": "^1.6.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@types/node": "^24.13.2",
        "@types/react": "19.0.2",
        "@types/react-dom": "19.0.2",
        "@vitest/coverage-v8": "^4.1.7",
        "jsdom": "^28.1.0",
        "tailwindcss": "^4",
        "typescript": "5.7.2",
        "vitest": "^4.1.7"
    },
    "volta": {
        "node": "24.18.0"
    },
    "engines": {
        "node": ">=24.0.0 <25.0.0",
        "npm": ">=11.0.0"
    }
}
